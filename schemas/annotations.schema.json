{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/video-segment-annotations.schema.json",
  "title": "Video segment temporal classification dataset",
  "type": "object",
  "required": ["schema_version", "dataset_type", "source", "label_map", "annotations"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "dataset_type": { "const": "temporal_video_classification" },
    "task": { "const": "video_segment_classification" },
    "time_unit": { "const": "seconds" },
    "source": {
      "type": "object",
      "required": ["file_name", "fps", "duration_sec"],
      "properties": {
        "file_name": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "label_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "sample_type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "sample_type": { "enum": ["positive", "negative"] }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "clip_path", "sample_type", "class_id", "class_name", "start_sec", "end_sec", "duration_sec", "start_frame", "end_frame"],
        "properties": {
          "id": { "type": "string" },
          "clip_path": { "type": "string" },
          "sample_type": { "enum": ["positive", "negative"] },
          "class_id": { "type": "string" },
          "class_name": { "type": "string" },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "exclusiveMinimum": 0 },
          "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
